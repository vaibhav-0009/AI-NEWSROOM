PORT=5000
COLLECTION_INTERVAL_MINUTES=5

# Groq AI (recommended): paste your Groq API key between the equals sign and save.
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=PASTE_GROQ_API_KEY_HERE
GROQ_MODEL=llama-3.3-70b-versatile

# Optional fallback for another OpenAI-compatible provider (leave blank to use Groq only)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Optional local fallback; disabled by default because this project is configured for Groq.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Fully automatic collection + AI generation + publishing
AUTO_PUBLISH=true

# Admin-only newsroom login. Change this before sharing/deploying the site.
ADMIN_PASSWORD=ChangeThisAdminPassword123!
